APP_NAME=ApplySense AI
ENV=dev
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_me_with_long_random_key
ACCESS_TOKEN_EXPIRE_MINUTES=120

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/applysense
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/applysense
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

MATCH_THRESHOLD=70
EMBEDDING_MODE=local
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LATEX_OUTPUT_DIR=./generated/resumes
LATEX_TEMPLATE_PATH=app/templates/resume_template.tex.j2

GMAIL_POLL_SECONDS=1800
JOB_INGEST_CRON=0 7 * * *
EMAIL_MONITOR_CRON=*/30 * * * *

AES256_KEY_B64=replace_me_with_32byte_key_base64
