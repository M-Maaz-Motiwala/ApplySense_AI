APP_NAME=ApplySense_AI
ENV=dev
API_V1_PREFIX=/api/v1

SECRET_KEY= # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=120

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=applysense

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/applysense
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/applysense

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

MATCH_THRESHOLD=70
EMBEDDING_MODE=local

GEMINI_API_KEY= # Get from Google Cloud Console
# OLLAMA_ENDPOINT=http://host.docker.internal:11434/api/generate
# OLLAMA_MODEL=llama3
GROQ_API_KEY= # Get from GROQ Console
GROQ_MODEL=llama-3.1-8b-instant

LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2

LATEX_OUTPUT_DIR=/app/generated/resumes
LATEX_TEMPLATE_PATH=app/templates/resume_template.tex.j2

GMAIL_POLL_SECONDS=1800
JOB_INGEST_CRON=0 7 * * *
EMAIL_MONITOR_CRON=*/30 * * * *

AES256_KEY_B64=  #run on ApplySense_AI/ -> python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"